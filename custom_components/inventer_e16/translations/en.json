{
  "config": {
    "flow_title": "{name}",
    "step": {
      "dhcp_confirm": {
        "title": "inVENTer controller found",
        "description": "Found an Easy Connect e16 at {host} (device ID {device_id}). Enter its PSK - read it once over Bluetooth with tools/e16_onboard.py.",
        "data": {
          "psk": "PSK"
        },
        "data_description": {
          "psk": "Pre-shared key as 16 hex characters, printed by the onboarding tool."
        }
      },
      "user": {
        "title": "inVENTer Easy Connect e16",
        "description": "The controller must be on your Wi-Fi. Read device ID and PSK once over Bluetooth with tools/e16_onboard.py.",
        "data": {
          "host": "Host",
          "device_id": "Device ID",
          "psk": "PSK"
        },
        "data_description": {
          "host": "IP address or host name of the controller (reserve it in your DHCP server).",
          "device_id": "Device identity printed by the onboarding tool, e.g. ABCDE-FGHIJ.",
          "psk": "Pre-shared key as 16 hex characters, printed by the onboarding tool."
        }
      },
      "reauth_confirm": {
        "title": "Controller rejected the PSK",
        "description": "The controller at {host} no longer accepts the stored key - usually after a factory reset or a replaced controller. Read the PSK again with tools/e16_onboard.py.",
        "data": {
          "psk": "PSK"
        },
        "data_description": {
          "psk": "Pre-shared key as 16 hex characters, printed by the onboarding tool."
        }
      },
      "reconfigure": {
        "title": "Change host or PSK",
        "description": "Entities, history and dashboards stay as they are.",
        "data": {
          "host": "Host",
          "psk": "PSK"
        },
        "data_description": {
          "host": "IP address or host name of the controller (reserve it in your DHCP server).",
          "psk": "Leave empty to keep the stored key."
        }
      }
    },
    "error": {
      "cannot_connect": "Cannot reach the controller on TCP 47820.",
      "invalid_key": "PSK invalid or unexpected reply."
    },
    "abort": {
      "already_configured": "This controller is already configured.",
      "not_supported": "This device does not look like an Easy Connect e16.",
      "reauth_successful": "New PSK saved.",
      "reconfigure_successful": "Settings updated."
    }
  },
  "services": {
    "set_mode": {
      "name": "Set mode",
      "description": "Time-limited command like in the app: mode, speed and duration. Afterwards the controller returns to its profile.",
      "fields": {
        "mode": {
          "name": "Mode",
          "description": "Heat recovery, ventilation or pause."
        },
        "speed": {
          "name": "Speed",
          "description": "1 to 4; ignored for pause."
        },
        "minutes": {
          "name": "Duration",
          "description": "15 min to 8 h. Default: the command duration entity."
        }
      }
    },
    "get_time_program": {
      "name": "Get time program",
      "description": "Reads the time program of a ventilation profile (read only). Response: entries with time, weekdays, mode and speed.",
      "fields": {
        "profile": {
          "name": "Profile",
          "description": "Default: the zone's current profile."
        }
      }
    },
    "set_time_program_entry": {
      "name": "Set time program entry",
      "description": "Writes one entry of a profile's time program and reads it back. Changes how the controller runs whenever that profile is active.",
      "fields": {
        "profile": {
          "name": "Profile",
          "description": "Ventilation profile whose time program is changed."
        },
        "entry": {
          "name": "Entry",
          "description": "Slot 0-31. The response of get_time_program shows which slots are used."
        },
        "time": {
          "name": "Start time",
          "description": "From this time on the entry applies (minutes; seconds are ignored)."
        },
        "days": {
          "name": "Weekdays",
          "description": "Days on which the entry applies."
        },
        "mode": {
          "name": "Mode",
          "description": "Heat recovery, ventilation or pause."
        },
        "speed": {
          "name": "Speed",
          "description": "1 to 4; ignored for pause."
        }
      }
    },
    "delete_time_program_entry": {
      "name": "Delete time program entry",
      "description": "Deletes one entry of a profile's time program (the entry becomes empty) and reads it back.",
      "fields": {
        "profile": {
          "name": "Profile",
          "description": "Ventilation profile whose time program is changed."
        },
        "entry": {
          "name": "Entry",
          "description": "Slot 0-31. The response of get_time_program shows which slots are used."
        }
      }
    }
  },
